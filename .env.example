DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockshield?schema=public"
REDIS_URL="redis://localhost:6379"
STOCKSHIELD_ENCRYPTION_KEY="change-this-local-dev-secret"
STOCKSHIELD_INTERNAL_API_TOKEN="change-this-local-admin-token"
STOCKSHIELD_AUTH_DISABLED="false"
STOCKSHIELD_ALLOWED_TENANT_IDS=""
STOCKSHIELD_TENANT_SCOPE_REQUIRED="false"
STOCKSHIELD_TENANT_SCOPE_DISABLED="false"
SHOPIFY_API_VERSION="2025-10"
SHOPIFY_WEBHOOK_SECRET="replace-with-shopify-client-secret"

OMS_DATABASE_URL="postgresql://readonly:readonly@localhost:5432/oms"
OMS_INVENTORY_TABLE="inventory_snapshot"
OMS_TENANT_COLUMN="tenant_id"
OMS_ROW_ID_COLUMN="id"
OMS_SKU_COLUMN="sku"
OMS_LOCATION_COLUMN="location_id"
OMS_STOCKED_COLUMN="stocked_quantity"
OMS_RESERVED_COLUMN="reserved_quantity"
OMS_UPDATED_AT_COLUMN="updated_at"

DRIFT_SCAN_INTERVAL_MINUTES="5"
DRIFT_SCAN_LIMIT="1000"
DRIFT_THRESHOLD="0"
DRIFT_SCAN_CONCURRENCY="2"
DRIFT_FIX_CONCURRENCY="8"
DRIFT_RECHECK_CONCURRENCY="5"
DRIFT_FIX_LOCK_TTL_MS="60000"

WORKER_ENABLED="true"
SCHEDULER_ENABLED="true"

STOCKSHIELD_BASE_URL="http://localhost:3000"
STOCKSHIELD_SMOKE_TENANT_ID="store_1"
STOCKSHIELD_DEMO_TENANT_ID="store_1"
STOCKSHIELD_DEMO_LOCATION_ID="loc_1"
STOCKSHIELD_LOAD_TENANT_ID="store_1"
LOAD_REQUESTS="100"
LOAD_CONCURRENCY="10"
LOAD_P95_MS="1000"
