{
  "name": "stockshield",
  "version": "1.0.0",
  "description": "StockShield - inventory drift guard service",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/main-worker.ts",
    "dev:scheduler": "tsx watch src/main-scheduler.ts",
    "start": "npm run start:api",
    "start:api": "tsx src/main.ts",
    "start:worker": "tsx src/main-worker.ts",
    "start:scheduler": "tsx src/main-scheduler.ts",
    "start:prod:api": "node dist/main.js",
    "start:prod:worker": "node dist/main-worker.js",
    "start:prod:scheduler": "node dist/main-scheduler.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run prisma:validate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "validate:env": "node scripts/validate-env.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:hybrid": "node scripts/hybrid-smoke.mjs",
    "load:check": "node scripts/load-check.mjs",
    "load:hybrid": "node scripts/load-hybrid-orders.mjs",
    "demo:api": "node scripts/demo-flow.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "local:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SumiX21-beep/StockShield.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SumiX21-beep/StockShield/issues"
  },
  "homepage": "https://github.com/SumiX21-beep/StockShield#readme",
  "dependencies": {
    "@nestjs/common": "^11.1.23",
    "@nestjs/core": "^11.1.23",
    "@nestjs/platform-express": "^11.1.23",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.77.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
